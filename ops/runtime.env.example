# Copy to ~/.config/autonomo-tax/runtime.env, chmod 600 it, and replace values.
AUTONOMO_PRIVATE_ROOT=/home/autonomo/.local/share/spain-autonomo-taxes
AUTONOMO_RELEASE_ROOT=/srv/spain-autonomo-taxes
AUTONOMO_OPS_ROOT=/home/autonomo/.local/lib/autonomo-ops
AUTONOMO_DEPLOY_REPOSITORY=/srv/spain-autonomo-taxes/repository
AUTONOMO_BACKUP_DIR=/home/autonomo/.local/share/spain-autonomo-taxes/backups/sqlite
AUTONOMO_MONTHLY_BACKUP_DIR=/home/autonomo/.local/share/spain-autonomo-taxes/backups/monthly
# Required in production after the Yandex backend is provisioned.
# AUTONOMO_RECONCILE_BACKENDS=yandex_evidence
# AUTONOMO_ALERT_WEBHOOK=https://replace-with-private-alert-webhook.invalid/autonomo
AUTONOMO_ENABLE_STORAGE_MIGRATION=0
# Set this absolute path only for the schema-18 storage release.
# AUTONOMO_DRIVE_MOUNT_ROOT=/home/agent/mnt/gdrive-espana
# Encrypted rclone remotes; each is rooted at its matching raw S3 prefix.
# AUTONOMO_RCLONE_REMOTE=yandex-daily-crypt:
# AUTONOMO_RCLONE_MONTHLY_REMOTE=yandex-monthly-crypt:
# AUTONOMO_RCLONE_EVIDENCE_REMOTE=yandex-evidence-crypt:
# AUTONOMO_RCLONE_CONFIG=/absolute/private/path/rclone.conf
