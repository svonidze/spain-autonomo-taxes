[Unit]
Description=Spain autonomo accounting web (@SHA@)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=2

[Service]
Type=simple
EnvironmentFile=@SECRET_CONFIG_ROOT@/generations/@SECRET_SHA@/runtime.env
@MIGRATION_ENV@
WorkingDirectory=@RELEASE_ROOT@/releases/@SHA@
@MIGRATION_PRE@
@BACKEND_PRE@
ExecStart=@RELEASE_ROOT@/releases/@SHA@/.venv/bin/autonomo-web --project-root @RELEASE_ROOT@/releases/@SHA@ --config @SECRET_CONFIG_ROOT@/generations/@SECRET_SHA@/config.yaml --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=@PRIVATE_ROOT@

[Install]
WantedBy=default.target
