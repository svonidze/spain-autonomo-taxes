[Unit]
Description=Verify monthly Spain autonomo backup recovery
After=autonomo-backup-monthly.service
OnFailure=autonomo-backup-verification-alert.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/autonomo-tax/runtime.env
ExecStart=@OPS_ROOT@/verify-backup.sh monthly
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=@PRIVATE_ROOT@
