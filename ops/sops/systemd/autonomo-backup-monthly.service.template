[Unit]
Description=Monthly Spain autonomo backup
OnFailure=autonomo-alert.service

[Service]
Type=oneshot
EnvironmentFile=@SECRET_CONFIG_ROOT@/current/runtime.env
Environment=AUTONOMO_RUNTIME_ENV_PATH=@SECRET_CONFIG_ROOT@/current/runtime.env
Environment=AUTONOMO_BACKUP_CLASS=monthly
ExecStart=@OPS_ROOT@/backup.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=@PRIVATE_ROOT@
