# Copy to ~/.config/autonomo-tax/ops-bootstrap.env and chmod 600 it.
# This file contains only operational paths and immutable revision selectors.
AUTONOMO_PRIVATE_ROOT=/home/autonomo/.local/share/spain-autonomo-taxes
AUTONOMO_RELEASE_ROOT=/srv/spain-autonomo-taxes
AUTONOMO_OPS_ROOT=/home/autonomo/.local/lib/autonomo-ops
AUTONOMO_DEPLOY_REPOSITORY=/srv/spain-autonomo-taxes/repository
AUTONOMO_DEPLOY_REF=master
AUTONOMO_HEALTHCHECK_URL=https://replace-with-private-tailnet-host.invalid

AUTONOMO_SECRET_CONFIG_REPO=github.com:svonidze/spain-autonomo-taxes-secrets.git
AUTONOMO_SECRET_CONFIG_BRANCH=main
AUTONOMO_SECRET_CONFIG_MOUNT=/home/autonomo/.local/share/spain-autonomo-taxes/runtime-config
AUTONOMO_AGE_PRIVATE_KEY_PATH=/home/autonomo/.config/autonomo-tax/sops-age.key
AUTONOMO_EXPECTED_AGE_RECIPIENTS=age1replace-server-recipient,age1replace-offline-recovery-recipient
AUTONOMO_SECRET_DEPLOY_KEY_PATH=/home/autonomo/.ssh/autonomo-secrets-deploy
AUTONOMO_SECRET_KNOWN_HOSTS_PATH=/home/autonomo/.ssh/known_hosts
AUTONOMO_SECRET_SYNC_REQUIRED=1

# Release and recovery controls belong to the bootstrap layer, not runtime.env.
AUTONOMO_ENABLE_STORAGE_MIGRATION=0
# AUTONOMO_DRIVE_MOUNT_ROOT=/home/autonomo/mnt/gdrive-espana
# AUTONOMO_LEGACY_UNIT=autonomo-web.service
# AUTONOMO_ROLLBACK_SNAPSHOT=/absolute/private/path/pre-migration.sqlite
