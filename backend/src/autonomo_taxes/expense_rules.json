    {
      "id": "own_meals",
      "irpf": {"type": "per_day_cap", "cap_minor_per_day": {"spain": 2667, "spain_overnight": 5334, "abroad": 4808, "abroad_overnight": 9135}},
      "iva": {"type": "manual"},
      "evidence": "factura_completa_nif",
      "risk": "high",
      "risk_reason": "Only the taxpayer's own meals in restaurants or hotels while carrying out the activity, paid electronically; the business link, date and place must be provable. One draft covers one day. The higher overnight limits apply only to a stay in a municipality other than both the usual workplace and the residence; the AEAT guidance for the self-employed sets no municipality condition for the lower limits. The daily cap subtracts only postings linked to this rule on the same date. IVA needs a complete invoice and follows the IRPF deduction: above the daily cap only the IVA in proportion to the deductible part may be deducted.",
      "valid_from": "2018-01-01",
      "valid_to": null,
      "parser_categories": [],
      "sources": [
        {"title": "Ley 35/2006 (IRPF), art. 30.2.5.ª c)", "url": "https://www.boe.es/buscar/act.php?id=BOE-A-2006-20764#a30", "checked_on": "2026-10-01", "source_kind": "primary"},
